bgcolor="#FFFFFF";
    fontname="Helvetica,Arial,sans-serif";
    fontsize=14;
    pad="0.25,0.25";
    nodesep=0.4;
    ranksep=0.45;
    splines=ortho;

    node [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=12,
        shape=box,
        style="rounded,filled",
        fillcolor="#F8FAFC",
        color="#CBD5E1",
        penwidth=1.5,
        margin="0.15,0.12"
    ];

    edge [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=12,
        color="#64748B",
        fontcolor="#334155",
        penwidth=1.5
    ];