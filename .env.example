# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Security & Cryptography
JWT_SECRET=finconsent_super_secret_jwt_key_2026
SERVER_MASTER_KEY=finconsent_server_envelope_master_key_2026

# Database (Supports MONGODB_URI, MONGO_URI, or DATABASE_URL)
# For MongoDB Atlas in Production:
# Format: mongodb+srv://<username>:<url_encoded_password>@<cluster-host>/finconsent?retryWrites=true&w=majority
# Notes:
# 1. Percent-encode special characters in passwords (RFC 3986): '@' -> '%40', ':' -> '%3A', etc.
# 2. Whitelist 0.0.0.0/0 in MongoDB Atlas Network Access for Render dynamic outbound IPs.
# 3. Do not wrap URI in quotes in the Render dashboard.
MONGODB_URI=mongodb://localhost:27017/finconsent

# Production Storage Fallback Control (Strictly forbidden in production unless explicitly true)
# ALLOW_IN_MEMORY_FALLBACK=false

# Integrations (API Keys)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKey123
RESEND_API_KEY=re_sampleResendKey123
